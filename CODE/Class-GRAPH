class Graph {
private:
    int V;   // Number of vertices (barangays)
    vector< vector< pair<int, int> > > adj; // Adjacency list: each node stores (neighbor, distance)
    vector<bool> flooded; // Tracks flood status of each barangay (true = flooded)

public:
    Graph(int vertices) {
        V = vertices;            // Set number of vertices
        adj.resize(V);           // Resize adjacency list to hold V nodes
        flooded.resize(V, false);// Initially, all barangays are SAFE
    }

    void addEdge(int u, int v, int w) {
        // Adds a bidirectional edge (road) between barangays u and v with distance w
        adj[u].push_back(make_pair(v, w));
        adj[v].push_back(make_pair(u, w));
    }

    void markFlooded(int node) {
        // Marks a barangay as flooded (unsafe)
        flooded[node] = true;
    }

    void resetFlood() {
        // Resets all barangays to SAFE
        for (int i = 0; i < flooded.size(); i++)
            flooded[i] = false;
    }

    void displayFloodStatus(const vector<string>& names) {
        // Prints the flood status of each barangay
        cout << "\n--- FLOOD STATUS ---\n";
        for (int i = 0; i < V; i++) {
            cout << names[i] << ": "
                 << (flooded[i] ? "FLOODED" : "SAFE") << endl;
        }
    }

    int shortestDistance(int start, int end) {
        // Dijkstra’s Algorithm: finds shortest path from start to end
        vector<int> dist(V, INT_MAX); // Distance array initialized to infinity
        priority_queue< pair<int,int>, vector< pair<int,int> >, greater< pair<int,int> > > pq;
        // Min-heap priority queue: stores (distance, node)

        dist[start] = 0;              // Distance to start node = 0
        pq.push(make_pair(0, start)); // Push start node into queue

        while (!pq.empty()) {
            pair<int,int> top = pq.top(); // Get node with smallest distance
            pq.pop();

            int d = top.first;  // Current distance
            int u = top.second; // Current node

            if (u == end) return d; // If we reached destination, return distance

            // Explore neighbors of current node
            for (int i = 0; i < adj[u].size(); i++) {
                int v = adj[u][i].first;  // Neighbor node
                int w = adj[u][i].second; // Edge weight (distance)

                // Relaxation step: update distance if shorter path found
                if (dist[u] + w < dist[v]) {
                    dist[v] = dist[u] + w;
                    pq.push(make_pair(dist[v], v)); // Push updated distance
                }
            }
        }

        return INT_MAX; // If no path found, return infinity
    }
};
